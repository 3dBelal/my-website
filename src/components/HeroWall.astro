---
// Home page hero: columns of short looping videos, all playing at once.
import { site } from '../lib/data';
import { media, posterUrl } from '../lib/media';

const tiles = await Promise.all(
	site.hero.map(async (file) => {
		const m = media(file);
		return { loop: m.loop!, poster: await posterUrl(m.image, 640) };
	}),
);
---

<section class="hero" aria-label="Intro">
	<div class="wall" aria-hidden="true">
		{
			tiles.map((t) => (
				<div class="tile">
					<video
						data-src={t.loop}
						poster={t.poster}
						muted
						loop
						playsinline
						preload="none"
						disablepictureinpicture
						tabindex="-1"
					/>
				</div>
			))
		}
	</div>
	<div class="scrim"></div>
	<div class="wrap copy">
		<h1>{site.name}</h1>
		<p class="role">{site.title}</p>
		<div class="ctas">
			<a class="btn light" href="/3d">3D Work</a>
			<a class="btn outline" href="/engineering">Engineering</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: calc(100svh - var(--nav-h));
		min-height: 480px;
		max-height: 1000px;
		overflow: hidden;
		background: #111;
		color: #fff;
	}
	.wall {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 2px;
	}
	.tile {
		position: relative;
		overflow: hidden;
		background: #1a1a1a;
	}
	.tile:nth-child(n + 5) {
		display: none;
	}
	.tile video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (min-width: 768px) {
		.wall {
			grid-template-columns: repeat(4, 1fr);
			grid-template-rows: 1fr;
		}
	}
	@media (min-width: 1100px) {
		.wall {
			grid-template-columns: repeat(5, 1fr);
		}
		.tile:nth-child(5) {
			display: block;
		}
	}
	.scrim {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 0.38);
	}
	.copy {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding-bottom: clamp(40px, 9vh, 96px);
	}
	h1 {
		font-size: clamp(38px, 7.2vw, 96px);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1;
		max-width: 12ch;
		text-shadow: 0 1px 24px rgb(0 0 0 / 0.25);
	}
	.role {
		margin-top: 14px;
		font-size: clamp(17px, 2vw, 22px);
		color: rgb(255 255 255 / 0.9);
	}
	.ctas {
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.btn.light {
		background: #fff;
		color: #111;
		border-color: #fff;
	}
	.btn.light:hover {
		background: #e9e9e9;
		border-color: #e9e9e9;
	}
	.btn.outline {
		background: transparent;
		color: #fff;
		border-color: rgb(255 255 255 / 0.8);
	}
	.btn.outline:hover {
		background: #fff;
		color: #111;
	}
	.ctas .btn:focus-visible {
		outline-color: #fff;
	}
</style>

<script>
	// Play every visible tile at the same time; pause tiles that scroll away.
	// Reduced motion: posters only.
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const videos = [...document.querySelectorAll<HTMLVideoElement>('.hero video[data-src]')];

	function start(v: HTMLVideoElement) {
		if (!v.src) {
			v.preload = 'metadata';
			v.src = v.dataset.src!;
		}
		v.play().catch(() => {});
	}

	if (!reduced && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const v = e.target as HTMLVideoElement;
					if (e.isIntersecting && v.offsetParent !== null) start(v);
					else v.pause();
				}
			},
			{ threshold: 0.05 },
		);
		videos.forEach((v) => io.observe(v));
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) return videos.forEach((v) => v.pause());
			for (const v of videos) {
				const r = v.getBoundingClientRect();
				if (v.offsetParent !== null && r.bottom > 0 && r.top < innerHeight) start(v);
			}
		});
	}
</script>
