---
// One tile in a gallery grid. Opens the lightbox (lbGroup) or a page (href).
import { Picture } from 'astro:assets';
import type { Media } from '../lib/media';
import { widthsFor } from '../lib/media';

interface Props {
	m: Media;
	title: string;
	caption?: string;
	kicker?: string;
	href?: string;
	fallbackHref?: string;
	lbGroup?: string;
	lbCount?: number;
	cats?: string[];
	eager?: boolean;
	sizes?: string;
}

const {
	m,
	title,
	caption,
	kicker,
	href,
	fallbackHref,
	lbGroup,
	lbCount = 1,
	cats = [],
	eager = false,
	sizes = '(min-width: 1024px) 33vw, (min-width: 560px) 50vw, 100vw',
} = Astro.props;
const link = href ?? fallbackHref ?? '#';
const action = href ? 'Read case study' : 'Open in viewer';
---

<article class="card" data-cats={cats.join(' ')}>
	<a
		class="hit reveal"
		href={link}
		data-lb-group={lbGroup}
		data-lb-index={lbGroup ? 0 : undefined}
	>
		<div class="media">
			<Picture
				src={m.image}
				formats={['avif', 'webp']}
				widths={widthsFor(m.image, [400, 800, 1200])}
				sizes={sizes}
				alt=""
				loading={eager ? 'eager' : 'lazy'}
				decoding="async"
			/>
			{
				m.type === 'video' && (
					<video data-src={m.loop} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" />
				)
			}
			{m.type === 'video' && <span class="badge" aria-hidden="true">▶</span>}
			{lbCount > 1 && <span class="count" aria-hidden="true">{lbCount}</span>}
		</div>
		<div class="meta">
			{kicker && <p class="kicker">{kicker}</p>}
			<h3>{title}</h3>
			{caption && <p class="cap">{caption}</p>}
			<span class="sr-only">{action}</span>
		</div>
	</a>
</article>

<style>
	.card {
		transition:
			opacity 250ms var(--ease),
			filter 250ms var(--ease);
	}
	.card[hidden] {
		display: none;
	}
	.hit {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: 6px;
	}
	.media {
		position: relative;
		overflow: hidden;
		border-radius: 6px;
		background: var(--soft);
		aspect-ratio: 4 / 5;
		transition:
			transform 250ms var(--ease),
			border-radius 250ms var(--ease);
	}
	.media :global(img),
	.media video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.media video {
		opacity: 0;
		transition: opacity 200ms;
	}
	.media video.on {
		opacity: 1;
	}
	.badge,
	.count {
		position: absolute;
		top: 10px;
		font-size: 11px;
		line-height: 1;
		color: #fff;
		background: rgb(0 0 0 / 0.45);
		border-radius: 999px;
		padding: 6px 8px;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		pointer-events: none;
	}
	.badge {
		left: 10px;
		padding-left: 9px;
	}
	.count {
		right: 10px;
	}
	.meta {
		padding-top: 12px;
	}
	.kicker {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 2px;
	}
	h3 {
		font-size: 16px;
		font-weight: 550;
		letter-spacing: -0.01em;
	}
	.cap {
		font-size: 14px;
		color: var(--muted);
		margin-top: 2px;
	}

	@media (hover: hover) and (pointer: fine) {
		:global(.grid:has(.card:hover)) .card:not(:hover) {
			opacity: 0.4;
			filter: grayscale(1);
		}
		.card:hover .media {
			transform: scale(1.02);
			border-radius: 18px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.media {
			transition: none;
		}
	}
</style>
