---
import Base from '../layouts/Base.astro';
import { cv, site } from '../lib/data';
---

<Base title="CV" description={`CV of ${site.name}: ${cv.headline}.`}>
	<article class="section top">
		<div class="wrap cv">
			<header class="cv-head">
				<div>
					<h1>{site.name}</h1>
					<p class="headline">{cv.headline}</p>
					<p class="contact">
						<a href={`mailto:${site.email}`}>{site.email}</a>
						<span aria-hidden="true">·</span>
						<a href={`tel:${cv.phone.replace(/\s/g, '')}`}>{cv.phone}</a>
						<span aria-hidden="true">·</span>
						<span>{site.location}</span>
					</p>
				</div>
				<a class="btn" href={site.cvPdf} download>
					Download CV (PDF)
				</a>
			</header>

			<section class="row">
				<h2>Summary</h2>
				<div><p class="summary">{cv.summary}</p></div>
			</section>

			<section class="row">
				<h2>Experience</h2>
				<div class="entries">
					{
						cv.experience.map((e) => (
							<div class="entry">
								<div class="entry-top">
									<h3>
										{e.role} · {e.org}
									</h3>
									<p class="when">{e.period}</p>
								</div>
								<p class="where">{e.place}</p>
								<ul>{e.points.map((p) => <li>{p}</li>)}</ul>
								{e.link && (
									<a class="link-arrow" href={e.link}>
										See the work →
									</a>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section class="row">
				<h2>Projects</h2>
				<div class="entries">
					{
						cv.projects.map((e) => (
							<div class="entry">
								<div class="entry-top">
									<h3>{e.title}</h3>
									<p class="when">{e.period}</p>
								</div>
								<ul>{e.points.map((p) => <li>{p}</li>)}</ul>
								{e.link && (
									<a class="link-arrow" href={e.link}>
										See the case study →
									</a>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section class="row">
				<h2>Education</h2>
				<div class="entries">
					{
						cv.education.map((e) => (
							<div class="entry">
								<div class="entry-top">
									<h3>{e.school}</h3>
									<p class="when">{e.period}</p>
								</div>
								<p class="where">
									{e.degree}, {e.field}
									{e.place && <> · {e.place}</>}
								</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="row">
				<h2>Volunteer</h2>
				<div class="entries">
					{
						cv.volunteer.map((e) => (
							<div class="entry">
								<div class="entry-top">
									<h3>{e.title}</h3>
									<p class="when">{e.period}</p>
								</div>
								{e.place && <p class="where">{e.place}</p>}
								<ul>{e.points.map((p) => <li>{p}</li>)}</ul>
							</div>
						))
					}
				</div>
			</section>

			<section class="row">
				<h2>Skills</h2>
				<dl class="skills">
					{
						cv.skills.map((s) => (
							<div>
								<dt>{s.group}</dt>
								<dd>{s.items}</dd>
							</div>
						))
					}
					<div>
						<dt>Languages</dt>
						<dd>{cv.languages}</dd>
					</div>
				</dl>
			</section>

			<div class="cv-foot">
				<a class="btn" href={site.cvPdf} download>Download CV (PDF)</a>
				<a class="btn ghost" href={`mailto:${site.email}`}>Email me</a>
			</div>
		</div>
	</article>
</Base>

<style>
	.top {
		padding-top: 56px;
	}
	.cv {
		max-width: 1100px;
	}
	.cv-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: 40px;
		border-bottom: 1px solid var(--line);
	}
	h1 {
		font-size: clamp(32px, 5vw, 56px);
		letter-spacing: -0.035em;
	}
	.headline {
		margin-top: 10px;
		font-size: 18px;
	}
	.contact {
		margin-top: 10px;
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		gap: 4px 10px;
		font-size: 15px;
	}
	.contact a {
		color: inherit;
	}
	.row {
		display: grid;
		gap: 16px;
		padding: 40px 0;
		border-bottom: 1px solid var(--line);
	}
	@media (min-width: 860px) {
		.row {
			grid-template-columns: 200px 1fr;
			gap: 40px;
		}
	}
	.row h2 {
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--muted);
		padding-top: 2px;
	}
	.summary {
		font-size: 18px;
		line-height: 1.6;
		max-width: 62ch;
	}
	.entries {
		display: grid;
		gap: 36px;
	}
	.entry-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 4px 20px;
		align-items: baseline;
	}
	h3 {
		font-size: 17px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.when {
		font-size: 14px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.where {
		margin-top: 2px;
		color: var(--muted);
		font-size: 15px;
	}
	ul {
		margin: 12px 0 0;
		padding-left: 1.1em;
		display: grid;
		gap: 6px;
		color: #2a2a2a;
		max-width: 72ch;
	}
	.entry .link-arrow {
		display: inline-block;
		margin-top: 12px;
		font-size: 14px;
	}
	.skills {
		margin: 0;
		display: grid;
		gap: 18px;
	}
	.skills dt {
		font-weight: 600;
		font-size: 15px;
	}
	.skills dd {
		margin: 2px 0 0;
		color: #2a2a2a;
	}
	.cv-foot {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	@media print {
		:global(.nav),
		:global(.foot),
		.btn,
		.link-arrow {
			display: none !important;
		}
	}
</style>
